# CoastStay frontend environment. Copy to .env.local and fill in.
# Only PUBLIC values belong here — anything prefixed VITE_ is bundled into the browser.

# Supabase project URL (local: http://127.0.0.1:56321)
VITE_SUPABASE_URL=http://127.0.0.1:56321
# Publishable / anon key (local: `npx supabase status` → "Publishable key" / "anon key")
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public URL of the app, used in invitation and password-reset links
VITE_APP_URL=http://localhost:5207

# NEVER put the service-role / secret key in this file or in any VITE_ variable.
